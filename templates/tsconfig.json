{
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "dom", "dom.iterable"]
  },
  "include": ["template/src", "react"]
}
